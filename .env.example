# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=

# Optional model overrides (DeepSeek API model IDs, without a provider prefix).
# Thinking mode is disabled for all roles by the course wrapper.
# CS329Z_GRADING_MODEL=deepseek-flash
# CS329Z_USER_MODEL=deepseek-flash
# CS329Z_JUDGE_MODEL=deepseek-v4-pro

# Optional local limits
# CS329Z_BUDGET_USD=5       # stops new calls once estimated ledger spending reaches this
# CS329Z_EVAL_SLICE=5       # run live tests on the first N items only
